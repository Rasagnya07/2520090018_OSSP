5A)
#include <stdio.h>
#include <string.h>

int main()
{
    char input[100];
    char stored[100];

    printf("Enter text inside single quotes: ");
    fgets(input, sizeof(input), stdin);

    // Store the quoted string
    strcpy(stored, input);

    printf("\nStored string: %s", stored);

    printf("Single quotes preserve the literal content.\n");
    printf("Variable expansion is ignored inside single quotes.\n");

    return 0;
}

5B)
#include <stdio.h>
#include <stdlib.h>

int main()
{
    char input[100];
    char *user;

    // Get the USER environment variable
    user = getenv("USER");

    printf("Enter text inside double quotes: ");
    fgets(input, sizeof(input), stdin);

    printf("\nInput: %s", input);

    if (user != NULL)
    {
        printf("Variable expansion: Hello %s\n", user);
    }

    printf("Double quotes preserve spaces.\n");
    printf("Double quotes allow variable expansion.\n");

    return 0;
}
