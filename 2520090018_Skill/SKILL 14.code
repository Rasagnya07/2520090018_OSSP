14A)
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/wait.h>

#define MAX_INPUT 200

int main()
{
    char input[MAX_INPUT];
    char command[100];
    char argument[100];
    char filename[100];

    int output_file;
    int original_stdout;
    pid_t pid;

    printf("Enter command with append redirection: ");

    fgets(input, sizeof(input), stdin);

    /* Remove newline */
    input[strcspn(input, "\n")] = '\0';

    /*
     * Parse:
     * command argument >> filename
     *
     * Example:
     * echo Hello >> output.txt
     */
    if (sscanf(input, "%s %s >> %s",
               command, argument, filename) != 3)
    {
        printf("Invalid input format.\n");
        printf("Use: command argument >> filename\n");
        return 1;
    }

    printf("Command: %s\n", command);
    printf("Argument: %s\n", argument);
    printf("Output file: %s\n", filename);

    /*
     * Open file in append mode.
     *
     * O_WRONLY -> write only
     * O_CREAT  -> create if file doesn't exist
     * O_APPEND -> write at the end of the file
     */
    output_file = open(filename,
                       O_WRONLY | O_CREAT | O_APPEND,
                       0644);

    if (output_file == -1)
    {
        perror("Error opening output file");
        printf("Check file permissions or the directory.\n");
        return 1;
    }

    printf("Output file opened in append mode.\n");

    /*
     * Save original stdout.
     */
    original_stdout = dup(STDOUT_FILENO);

    if (original_stdout == -1)
    {
        perror("dup");
        close(output_file);
        return 1;
    }

    /*
     * Redirect stdout to the output file.
     */
    if (dup2(output_file, STDOUT_FILENO) == -1)
    {
        perror("dup2");
        close(output_file);
        close(original_stdout);
        return 1;
    }

    /* Close original file descriptor */
    close(output_file);

    /*
     * Create child process.
     */
    pid = fork();

    if (pid < 0)
    {
        perror("fork");
        return 1;
    }

    /*
     * Child process.
     */
    if (pid == 0)
    {
        /*
         * Execute command.
         *
         * Example:
         * echo Hello
         */
        execlp(command, command, argument, NULL);

        /* If exec fails */
        perror("execlp");
        exit(1);
    }

    /*
     * Parent waits for child.
     */
    wait(NULL);

    /*
     * Restore original stdout.
     */
    if (dup2(original_stdout, STDOUT_FILENO) == -1)
    {
        perror("Restoring stdout");
        close(original_stdout);
        return 1;
    }

    close(original_stdout);

    printf("\nStandard output restored successfully.\n");
    printf("Data appended successfully to: %s\n", filename);

    return 0;
}

14B)
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/wait.h>

#define MAX_INPUT 200

int main()
{
    char input[MAX_INPUT];
    char command[100];
    char argument[100];
    char filename[100];

    int error_file;
    int original_stderr;
    pid_t pid;
    int status;

    printf("Enter command with stderr redirection: ");

    fgets(input, sizeof(input), stdin);

    /* Remove newline */
    input[strcspn(input, "\n")] = '\0';

    /*
     * Parse:
     * command argument 2> filename
     *
     * Example:
     * ls nonexistent.txt 2> error.txt
     */
    if (sscanf(input, "%s %s 2> %s",
               command, argument, filename) != 3)
    {
        printf("Invalid input format.\n");
        printf("Use: command argument 2> filename\n");
        return 1;
    }

    printf("Command: %s\n", command);
    printf("Argument: %s\n", argument);
    printf("Error file: %s\n", filename);

    /*
     * Open the error output file.
     *
     * O_WRONLY -> write only
     * O_CREAT  -> create if it doesn't exist
     * O_TRUNC  -> remove old contents
     */
    error_file = open(filename,
                      O_WRONLY | O_CREAT | O_TRUNC,
                      0644);

    if (error_file == -1)
    {
        perror("Error opening error file");
        printf("Could not create the error output file.\n");
        return 1;
    }

    printf("Error output file opened successfully.\n");

    /*
     * Save original stderr.
     */
    original_stderr = dup(STDERR_FILENO);

    if (original_stderr == -1)
    {
        perror("dup");
        close(error_file);
        return 1;
    }

    /*
     * Redirect stderr to the error file.
     */
    if (dup2(error_file, STDERR_FILENO) == -1)
    {
        perror("dup2");
        close(error_file);
        close(original_stderr);
        return 1;
    }

    /* Close original file descriptor */
    close(error_file);

    /*
     * Create child process.
     */
    pid = fork();

    if (pid < 0)
    {
        perror("fork");
        return 1;
    }

    /*
     * Child process.
     */
    if (pid == 0)
    {
        /*
         * Execute command.
         *
         * If the command produces an error,
         * the error goes into the file.
         */
        execlp(command, command, argument, NULL);

        /*
         * If execlp fails, this error also
         * goes to the redirected stderr.
         */
        perror("Command execution failed");
        exit(1);
    }

    /*
     * Parent waits for child.
     */
    waitpid(pid, &status, 0);

    /*
     * Restore original stderr.
     */
    if (dup2(original_stderr, STDERR_FILENO) == -1)
    {
        perror("Restoring stderr");
        close(original_stderr);
        return 1;
    }

    close(original_stderr);

    /*
     * Check child status.
     */
    if (WIFEXITED(status))
    {
        printf("\nChild process exited with status: %d\n",
               WEXITSTATUS(status));
    }

    printf("Standard error restored successfully.\n");
    printf("Error output saved in: %s\n", filename);

    return 0;
}
