11A - Command History Buffer

#include <stdio.h>
#include <string.h>

#define MAX_HISTORY 5
#define MAX_LENGTH 100

int main()
{
    char history[MAX_HISTORY][MAX_LENGTH];
    int count = 0;
    int i;
    char command[MAX_LENGTH];

    printf("Enter commands (type 'exit' to stop):\n");

    while (1)
    {
        printf("> ");
        fgets(command, sizeof(command), stdin);

        // Remove newline
        command[strcspn(command, "\n")] = '\0';

        // Process exit request
        if (strcmp(command, "exit") == 0)
            break;

        // Store command
        if (count < MAX_HISTORY)
        {
            strcpy(history[count], command);
            count++;
        }
        else
        {
            // Capacity limit reached
            printf("History full! Removing oldest command.\n");

            // Shift commands left
            for (i = 0; i < MAX_HISTORY - 1; i++)
            {
                strcpy(history[i], history[i + 1]);
            }

            // Store new command at the end
            strcpy(history[MAX_HISTORY - 1], command);
        }
    }

    // Display command history
    printf("\nCommand History:\n");

    for (i = 0; i < count; i++)
    {
        printf("%d  %s\n", i + 1, history[i]);
    }

    // Retrieve an entry
    if (count > 0)
    {
        printf("\nLast command: %s\n", history[count - 1]);
    }

    // Validate consistency
    if (count <= MAX_HISTORY)
        printf("History buffer is consistent.\n");
    else
        printf("History buffer error.\n");

    return 0;
}

11B - Simple Command Pipeline

#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
    // Pipeline structure
    char *command1[] = {"ls", NULL};
    char *command2[] = {"wc", "-l", NULL};

    int pipefd[2];
    pid_t pid1, pid2;

    // Create pipeline
    if (pipe(pipefd) == -1)
    {
        printf("Error creating pipe.\n");
        return 1;
    }

    // Validate pipeline layout
    printf("Pipeline: ls | wc -l\n");
    printf("Command 1: ls\n");
    printf("Command 2: wc -l\n");

    // Create first process
    pid1 = fork();

    if (pid1 == 0)
    {
        // Connect stdout of command 1 to pipe
        dup2(pipefd[1], STDOUT_FILENO);

        close(pipefd[0]);
        close(pipefd[1]);

        // Execute first command
        execvp(command1[0], command1);

        printf("Error executing ls.\n");
        return 1;
    }

    // Create second process
    pid2 = fork();

    if (pid2 == 0)
    {
        // Connect stdin of command 2 to pipe
        dup2(pipefd[0], STDIN_FILENO);

        close(pipefd[0]);
        close(pipefd[1]);

        // Execute second command
        execvp(command2[0], command2);

        printf("Error executing wc.\n");
        return 1;
    }

    // Parent closes pipe
    close(pipefd[0]);
    close(pipefd[1]);

    // Maintain execution order
    waitpid(pid1, NULL, 0);
    waitpid(pid2, NULL, 0);

    printf("Pipeline executed successfully.\n");

    return 0;
}
