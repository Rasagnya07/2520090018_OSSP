13A - Input Redirection

#include <stdio.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>
#include <stdlib.h>
#include <sys/wait.h>

int main()
{
    char input[200];
    char command[100];
    char filename[100];

    printf("Enter command with input redirection:\n");
    printf("Example: cat < input.txt\n\n");

    printf("> ");
    fgets(input, sizeof(input), stdin);

    // Remove newline
    input[strcspn(input, "\n")] = '\0';

    // PARSE INPUT REDIRECTION
    char *symbol = strchr(input, '<');

    if (symbol == NULL)
    {
        printf("Error: No input redirection found.\n");
        return 1;
    }

    // Get command
    *symbol = '\0';
    strcpy(command, input);

    // Get filename
    strcpy(filename, symbol + 1);

    // Remove leading spaces
    while (filename[0] == ' ')
        memmove(filename, filename + 1, strlen(filename));

    // OPEN INPUT FILE
    int fd = open(filename, O_RDONLY);

    // HANDLE MISSING FILE
    if (fd < 0)
    {
        printf("Error: File '%s' not found.\n", filename);
        return 1;
    }

    // Save original stdin
    int saved_stdin = dup(STDIN_FILENO);

    // REDIRECT stdin
    dup2(fd, STDIN_FILENO);

    close(fd);

    printf("\nInput redirected from: %s\n", filename);

    // Execute command
    if (fork() == 0)
    {
        execlp(command, command, NULL);

        printf("Error executing command.\n");
        exit(1);
    }

    wait(NULL);

    // RESTORE stdin
    dup2(saved_stdin, STDIN_FILENO);
    close(saved_stdin);

    printf("\nInput redirection completed.\n");

    return 0;
}

13B - Output Redirection

#include <stdio.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>
#include <stdlib.h>
#include <sys/wait.h>

int main()
{
    char input[200];
    char command[100];
    char filename[100];

    printf("Enter command with output redirection:\n");
    printf("Example: ls > output.txt\n\n");

    printf("> ");
    fgets(input, sizeof(input), stdin);

    // Remove newline
    input[strcspn(input, "\n")] = '\0';

    // PARSE OUTPUT REDIRECTION
    char *symbol = strchr(input, '>');

    if (symbol == NULL)
    {
        printf("Error: No output redirection found.\n");
        return 1;
    }

    // Get command
    *symbol = '\0';
    strcpy(command, input);

    // Get filename
    strcpy(filename, symbol + 1);

    // Remove leading spaces
    while (filename[0] == ' ')
        memmove(filename, filename + 1, strlen(filename));

    // CREATE OUTPUT FILE
    int fd = open(filename, O_WRONLY | O_CREAT | O_TRUNC, 0644);

    // HANDLE PERMISSION/FILE ERROR
    if (fd < 0)
    {
        printf("Error: Cannot create or open output file.\n");
        return 1;
    }

    // Save original stdout
    int saved_stdout = dup(STDOUT_FILENO);

    // REDIRECT stdout
    dup2(fd, STDOUT_FILENO);

    close(fd);

    // Execute command
    if (fork() == 0)
    {
        execlp(command, command, NULL);

        // Restore stdout before error message
        dup2(saved_stdout, STDOUT_FILENO);

        printf("Error executing command.\n");
        exit(1);
    }

    wait(NULL);

    // RESTORE stdout
    dup2(saved_stdout, STDOUT_FILENO);
    close(saved_stdout);

    printf("Output successfully written to: %s\n", filename);

    // VERIFY OUTPUT DATA
    FILE *file = fopen(filename, "r");

    if (file != NULL)
    {
        char line[200];

        printf("\nOutput file contents:\n");

        while (fgets(line, sizeof(line), file) != NULL)
        {
            printf("%s", line);
        }

        fclose(file);
    }
    else
    {
        printf("Error verifying output file.\n");
    }

    return 0;
}
