6A)
~ server:
#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <string.h>

int main() {
    char message[100];
    char response[] = "Message received by server";

    mkfifo("myfifo", 0666);

    int fd = open("myfifo", O_RDONLY);

    read(fd, message, sizeof(message));

    printf("Server received: %s\n", message);

    close(fd);

    fd = open("myfifo", O_WRONLY);

    write(fd, response, strlen(response) + 1);

    close(fd);

    return 0;
}

~ client

#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main() {
    char message[] = "Hello Server!";
    char response[100];

    int fd = open("myfifo", O_WRONLY);

    write(fd, message, sizeof(message));

    close(fd);

    fd = open("myfifo", O_RDONLY);

    read(fd, response, sizeof(response));

    printf("Client received: %s\n", response);

    close(fd);

    return 0;
}


6B) SIGNALS
#include <stdio.h>
#include <signal.h>
#include <unistd.h>

void handler(int sig) {

    if (sig == SIGINT)
        printf("\nSIGINT received!\n");

    else if (sig == SIGTERM)
        printf("SIGTERM received!\n");

    else if (sig == SIGUSR1)
        printf("SIGUSR1 received!\n");
}

int main() {

    signal(SIGINT, handler);
    signal(SIGTERM, handler);
    signal(SIGUSR1, handler);

    printf("Process ID: %d\n", getpid());
    printf("Waiting for signals...\n");

    while (1) {
        pause();
    }

    return 0;
}
