9A)
#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int src, dest;
    char buffer[100];
    int n;

    // Open source file
    src = open("source.txt", O_RDONLY);

    if (src < 0)
    {
        printf("Error opening source file\n");
        return 1;
    }

    // Create destination file
    dest = open("copy.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (dest < 0)
    {
        printf("Error creating destination file\n");
        close(src);
        return 1;
    }

    // Copy using read() and write()
    while ((n = read(src, buffer, sizeof(buffer))) > 0)
    {
        write(dest, buffer, n);
    }

    // lseek() - move file pointer to beginning
    lseek(src, 0, SEEK_SET);

    close(src);
    close(dest);

    printf("File copied successfully using system calls.\n");

    return 0;
}

9B)
#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int fd;

    // Open file for output
    fd = open("output.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (fd < 0)
    {
        printf("Error opening file\n");
        return 1;
    }

    // Redirect stdout to output.txt
    dup2(fd, STDOUT_FILENO);

    close(fd);

    // This will go into output.txt
    printf("Hello! This output is redirected to a file.\n");
    printf("This is how shell I/O redirection works.\n");

    return 0;
}
