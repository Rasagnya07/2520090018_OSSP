-Creating a file:

#include <stdio.h>
int main()
{
 FILE *fp;
 fp = fopen("sample.txt", "w");
 if (fp == NULL)
 {
 printf("Cannot open file\n");
 return 1;
 }
 fprintf(fp, "Hello, this is a test file.\n");
 fclose(fp);
 printf("File created successfully.\n");
 return 0;
}

Tasks (1-7)
  1. chmod 600 sample.txt
# Or symbolic: chmod u=rw,g=,o= sample.txt

  2. chmod 660 sample.txt
# Or symbolic: chmod ug=rw,o= sample.txt

  3. chmod 600 sample.txt

  4. chmod 644 sample.txt

