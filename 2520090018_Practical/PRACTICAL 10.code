10A)
#include <stdio.h>
#include <unistd.h>

int main()
{
    // Create the original file
    FILE *fp = fopen("original.txt", "w");

    if (fp == NULL)
    {
        printf("Error creating file\n");
        return 1;
    }

    fprintf(fp, "Hello, inode!\n");
    fclose(fp);

    // Create hard link
    if (link("original.txt", "hardlink.txt") == 0)
        printf("Hard link created successfully.\n");
    else
        printf("Error creating hard link.\n");

    // Create symbolic link
    if (symlink("original.txt", "softlink.txt") == 0)
        printf("Symbolic link created successfully.\n");
    else
        printf("Error creating symbolic link.\n");

    return 0;
}

10B)
#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/mman.h>
#include <sys/stat.h>

int main()
{
    int fd;
    char *data;
    struct stat st;

    // Open file
    fd = open("mmapfile.txt", O_RDWR);

    if (fd < 0)
    {
        printf("Error opening file\n");
        return 1;
    }

    // Get file size
    stat("mmapfile.txt", &st);

    // Map file into memory
    data = mmap(NULL, st.st_size,
                PROT_READ | PROT_WRITE,
                MAP_SHARED, fd, 0);

    if (data == MAP_FAILED)
    {
        printf("mmap failed\n");
        close(fd);
        return 1;
    }

    // Read file using memory
    printf("File contents:\n");
    printf("%s\n", data);

    // Modify file using memory
    data[0] = 'H';

    // Write changes to file
    msync(data, st.st_size, MS_SYNC);

    // Unmap memory
    munmap(data, st.st_size);

    close(fd);

    printf("File modified successfully using mmap().\n");

    return 0;
}
