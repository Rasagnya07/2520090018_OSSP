#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int f1, f2;
    char ch;

    f1 = open("source.txt", O_RDONLY);

    if (f1 == -1)
    {
        printf("Cannot open source.txt\n");
        return 1;
    }

    f2 = open("dest.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (f2 == -1)
    {
        printf("Cannot create dest.txt\n");
        return 1;
    }

    while (read(f1, &ch, 1) > 0)
    {
        write(f2, &ch, 1);
    }

    close(f1);
    close(f2);

    printf("File Copied Successfully\n");

    return 0;
}
